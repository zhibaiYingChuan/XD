# ── 激活码签发工具的密钥材料（★ 最高优先级）──────────────
# 私钥一旦入库 = 任何人都能签发激活码 = 授权体系瞬间失效。
# 且 Git 历史无法真正清除（即使后续删除，commit 里仍在）。
tools/activation/*_private*.pem
# 签发日志含明文激活码 + 机器码，属用户隐私
tools/activation/ACTIVATION_LOG.json
tools/activation/LICENSE_LOG.json

# ★ 公钥现在放在 src/daoti_xuandun_personal/license_pub.pem，
#   随包分发，不受这里的规则影响。

# ── 测试临时产物 ──────────────────────────────────────────
tests/__pycache__/
*.tmp
_probe*.py
_tmp*.py

# 构建期生成的护栏密钥（每次构建都不同，入库等于公开）
build_secrets.json

# ── 不进公开仓库的内容 ─────────────────────────────────────
# 这个仓库面向**用户**：他们装的是编译好的客户端，不是来读你源码的。
# 下面这些是内部资产，留在本地磁盘（已加入本仓库忽略列表），
# 需要时从私有备份取回。

# 签发工具：完整的签发/换绑/吊销/传播审计实现。
# ★ 私钥不在其中（谁入库谁就完了），但这套代码公开等于告诉所有人
#   授权体系怎么运作。RS256 的安全性 100% 依赖私钥保密，
#   而工具公开会把「只有你知道怎么签」变成「所有人都知道，只差一把钥匙」。
tools/

# 攻击样本库与判据测试。
# test_false_positive.py 里写着「负例是配合判据构造的」——
# 这等于告诉攻击者判据边界在哪、哪里容易误报。
# 检测类产品的判据是核心资产，不是测试代码。
#
# ★ 例外：以下五个测试必须入库，它们防的都是「静默失效」。
#   ① test_guardrail_in_build.py
#      防「产物没有护栏却被当成防火墙发布」——
#      判据里没有任何攻击样本，只有路径与构建参数。
#   ② test_machine_code.py
#      防「机器码不稳定 / 算法漂移，用户永远激活不了」。
#   ③ test_desktop_gui_subsystem.py
#      防「发布版弹出 cmd 黑窗」——加对属性不报错、不崩，
#      只有读 PE 头的 Subsystem 字段才能确认。
#   ④ test_engine_response_contract.py
#      防「引擎返回驼峰键、Rust 按蛇形解析，激活一律失败」。
#   ⑤ test_relay_config.py
#      防「中转站地址被拼错一层（/v1beta/v1、/chat/completions/v1）」——
#      现象是 404，用户会去查中转站、查 Key、查网络，
#      唯独不会想到地址被拼坏了。判据只有地址字符串，不含任何检测逻辑。
#   ⑥ test_help_claims.py
#      防「帮助页文案与源码漂移」——托盘声称有并不存在的黄色态、
#      基线样本数夸大 10 倍、编造未实测的毫秒数、
#      把「宽松档仍阻断 API 密钥」说成「只拦明确危险」。
#      这些都不会让任何测试变红，却会让用户按错误预期行动
#      （比如以为宽松模式下密钥会外发）。判据只比对文案与常量。
#   ⑦ test_block_evidence.py
#      防「拦截了却拿不出依据」——阻断分支 return 得比通用落库路径早，
#      redaction_records 恒为 0 行；detail_json 写成 dict 而前端只渲染数组。
#      两者叠加的结果是：引擎拦得完全正确、/api/state 数字完全正确，
#      而用户手上没有任何可核对的依据，于是 40 条真实拦截
#      在界面上看起来就像 40 次误报。
#      这类故障的特征是「后端有数据、前端不显示」，
#      两边各自检查都会说自己对，只有跨层断言能拦住。
#   ⑧ test_reputation_score.py
#      防「信誉评分归因错误」——实测首页显示 0/100、扣分明细 −380，
#      查库发现那 19 次「危险」全部是「响应长度突变」：
#      用户问了个长问题（问「你好」3 字、回代码 11000 字），
#      中转站被扣了 380 分。分数还因此长期触底恒为 0，
#      此后任何新增风险都显示不出来。
#      公式本身没写错，错的是**输入的归因** ——
#      把用户自身导致的事件当成了中转站的罪证。
#      这类故障代码审查看不出来（实现自洽），
#      测试也不会红（公式没bug），只有把责任归属钉死才拦得住。
#   ⑨ test_multi_relay.py
#      防「多中转站看得见、用不了」——用户同时用两家时，
#      代理无条件用配置里的 Key 覆盖 Authorization，
#      于是「以为在用 A、实际扣 B 的钱」，而界面上没有任何提示。
#      本轮在这条链路上实测抓到三个静默故障：
#        ① 保存配置时把其余中转站的真实 Key 全换成掩码串
#           （前端整体回传 config.relay，而 others[].api_key 已是掩码）
#           ——不可逆，之后切到那家必然 401 而界面看不出异常；
#        ② 风险记到「当前启用项」头上而不是本次实际转发的那家；
#        ③ _resolve_upstream 写成 async 而调用处漏 await，
#           每个 AI 请求 500 ——单元测试全绿，因为它们只调它自己。
#      另外「只有切换、没有新增」意味着列表永远长不出第二家：
#      功能看起来存在，实际用户永远只有一家。
#   九者都是：编译不报错、已有测试全绿，只有真实环境才暴露。
#   2026-09-28 这几类问题里有三类是线上反馈才发现的。
#
#   用 /* 逐条排除而非 !tests/xxx 反向放行：
#   gitignore 不支持「目录被排除后再放行子项」，
#   写 !tests/test_x.py 是不生效的（实测被忽略）。
tests/*
!tests/test_guardrail_in_build.py
!tests/test_machine_code.py
!tests/test_desktop_gui_subsystem.py
!tests/test_engine_response_contract.py
!tests/test_relay_config.py
!tests/test_help_claims.py
!tests/test_block_evidence.py
!tests/test_reputation_score.py
!tests/test_multi_relay.py
# ★ 本轮新增（2026-10-03）。四条都是「把踩过的坑固化成门禁」：
#   test_dev_isolation —— 开发/测试与稳定版的数据隔离（曾污染用户配置）
#   test_statistical_never_blocks —— 统计类信号不得阻断（曾 88% 误报）
#   test_log_filters —— 日志列表与总数口径必须一致（曾「筛不出来」）
#   test_route_order —— 静态路由须在参数路由之前（曾 422 而无人能查因）
#   test_log_deletion_consistency —— 删日志后统计须跟着重算，
#     且原始敏感值必须连带删除（曾「清空了首页数字还在」，
#     而界面承诺的「不留存原始敏感值」当时是假的）
#   test_delete_e2e —— 同一条契约的真实 HTTP 端到端版。
#     上一份只调存储方法，而历史失效形态恰恰是
#     「底层方法对、路由没走它」，所以判据必须落在端点上。
#   test_content_policy_and_relay_sync —— 内容合规不得当作中转站篡改
#     （曾把「模型说了敏感词」翻成「中转站偷偷改写 AI 行为」），
#     以及中转站计数须随删日志重算（曾首页归零、卡片不动）。
#   test_pkg_and_relay_identity —— 代码内容不得当成「即将安装的包」
#     （曾把 label 判成 babel 的错拼并拦下对话），
#     以及同一主机不同 Key 的信誉须分开统计（曾两家的账混在一起）。
#   test_derived_state_consistency —— 派生数据必须能从日志解释
#     （曾出现「日志一条没有、卡片还扣着分」「干净响应被记成已告警」
#      「信誉指纹被 URL 解析吃掉」三处，共同特征是函数对、调用点错）。
!tests/test_dev_isolation.py
!tests/test_statistical_never_blocks.py
!tests/test_log_filters.py
!tests/test_route_order.py
!tests/test_log_deletion_consistency.py
!tests/test_delete_e2e.py
!tests/test_content_policy_and_relay_sync.py
!tests/test_pkg_and_relay_identity.py
!tests/test_derived_state_consistency.py
!tests/cdp_desktop_regression.py
!tests/cdp_popup_probe.py
!tests/mutation_check.py

# ── CI 门禁细节：防护门禁的存在与判据、发布流水线的公钥断言。
# 公开这些等于告诉破解者「我们重点防什么、怎么防的」。
#
# ★ 例外 1：release.yml 必须入库。
#   GitHub 只从 .github/workflows/ 读流水线，没有它就没有线上构建 ——
#   「线上编译」这件事本身依赖这个文件。
#   它只做构建与公钥断言（检查私钥有没有漏进仓库），
#   不含任何检测判据或攻击样本。
#
# ★ 例外 2：ci.yml 也入库，但入库的是**脱敏版**（ci.public.yml）。
#   GitHub 只会执行 .github/workflows/ 下的文件，所以公开仓库
#   里的 ci.yml 只能是脱敏版；完整版改存 .ci-local/，本地照常运行。
#
#   脱敏版保留「每次 push 跑测试」的行为，去掉门禁名称与判据 ——
#   公开 CI 是第一道网，本地那套更严格的门禁是第二道，两者都要有。
#
#   ★ 代价说清：公开 CI 能发现「测试挂了」，
#     但替代不了本地门禁（后者不在仓库里）。
.github/*
!.github/workflows/
.github/workflows/*
!.github/workflows/release.yml
# ★ 脱敏版 CI 入库。完整版在 .ci-local/ci.yml，本地运行不入库。
!.github/workflows/ci.yml
# 完整版门禁配置：含门禁名称与判据，仅本地使用
.ci-local/

# 内部开发文档（不对外发布）
docs/
GUARDRAIL.md

# 签发记录（内部）
*_LOG.json
.venv/
__pycache__/
